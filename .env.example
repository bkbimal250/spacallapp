# Django Settings
DEBUG=False
SECRET_KEY=generate-a-secure-secret-key-here
ALLOWED_HOSTS=apibackend.mastercall.in,localhost

# Database Configuration (PostgreSQL)
POSTGRES_DB=calllog_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL Configuration (Prod)
CORS_ALLOWED_ORIGINS=https://crm.mastercall.in,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://apibackend.mastercall.in,https://crm.mastercall.in

# SSL Settings
SECURE_SSL_REDIRECT=True

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CallLog System <noreply@calllogsystem.com>

# Hilite Multimedia SMS OTP
PHONE_OTP_SENDER=apps.accounts.services.sms_sender.send_phone_otp
SMS_API_URL=https://www.hilitemultimedia.co.in/websms/api/http/index.php
SMS_USERNAME=your-sms-username
SMS_API_KEY=your-sms-api-key
SMS_API_REQUEST=Text
SMS_ROUTE=ServiceImplicit
SMS_SENDER_ID=your-sender-id
SMS_TEMPLATE_ID=your-approved-template-id
SMS_MOBILE_COUNTRY_CODE=
SMS_OTP_MESSAGE_TEMPLATE=Dear Customer, your Code for login to Spa Advisor is {otp}. This Code is valid for 1 minutes. Do not share this OTP with anyone. Thank You
SKIP_SMS=false
SMS_VERIFY_SSL=false

# DoubleTick WhatsApp leads
DOUBLETICK_WEBHOOK_SECRET=your-doubletick-webhook-secret
DOUBLETICK_API_KEY=your-doubletick-api-key
DOUBLETICK_BASE_URL=https://public.doubletick.io
DOUBLETICK_SEND_TEXT_ENDPOINT=/whatsapp/message/text
DOUBLETICK_AUTH_HEADER=Authorization
DOUBLETICK_AUTH_SCHEME=Bearer
DOUBLETICK_SEND_FROM_WABA_NUMBER=
DOUBLETICK_PENDING_ATTENTION_MINUTES=10
DOUBLETICK_PENDING_ARCHIVE_DAYS=30
DOUBLETICK_LOCATION_REQUEST_MESSAGE=Please share your city and nearest area so we can find the best spa for you.

# Redis (Celery & Cache)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

