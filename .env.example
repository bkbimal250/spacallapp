# Django Settings
DEBUG=False
SECRET_KEY=generate-a-secure-secret-key-here
ALLOWED_HOSTS=apibackend.mastercall.in,localhost

# Database Configuration (PostgreSQL)
POSTGRES_DB=calllog_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL Configuration (Prod)
CORS_ALLOWED_ORIGINS=https://crm.mastercall.in,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://apibackend.mastercall.in,https://crm.mastercall.in

# SSL Settings
SECURE_SSL_REDIRECT=True

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CallLog System <noreply@calllogsystem.com>

# Redis (Celery & Cache)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
